// TELOS — esquema de base de datos.
// Convenciones:
// - Tablas en snake_case plural (@@map), modelos en PascalCase.
// - Dinero: Decimal(12,2) en Lempiras (HNL). Nunca texto.
// - Timestamps en UTC (timestamptz). La UI convierte a TELOS_TIMEZONE.
// - is_demo marca datos de demostración; `npm run demo:purge` los elimina.
// - Restricciones CHECK adicionales (stock >= 0, etc.) viven en la migración SQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Conexión directa (sin pooler) para migraciones. En local puede ser igual a DATABASE_URL.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ───────────────────────── Usuarios y acceso ─────────────────────────

enum Role {
  OWNER
  ADMIN
  SALES
  INVENTORY
  MARKETING
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  passwordHash     String    @map("password_hash")
  role             Role
  active           Boolean   @default(true)
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  sessions           Session[]
  passwordResets     PasswordResetToken[]
  inventoryMovements InventoryMovement[]
  sales              Sale[]               @relation("SaleSeller")
  salesCreated       Sale[]               @relation("SaleCreatedBy")
  purchasesCreated   Purchase[]
  auditLogs          AuditLog[]
  payments           Payment[]

  @@map("users")
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  userAgent  String?  @map("user_agent")
  ip         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ───────────────────────── Catálogo ─────────────────────────

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  // Código corto usado en el SKU: CAM, CMT, GOR...
  code      String    @unique @db.VarChar(4)
  slug      String    @unique
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  products  Product[]

  @@map("categories")
}

enum ProductStatus {
  DRAFT // borrador: no visible en la web
  ACTIVE // publicado
  ARCHIVED // desactivado (soft delete)
}

model Product {
  id           String        @id @default(cuid())
  // Código comercial estable: TLS-CMT-001. Se usa en la URL pública.
  code         String        @unique
  name         String
  slug         String        @unique
  categoryId   String        @map("category_id")
  brand        String?
  description  String?
  material     String?
  status       ProductStatus @default(DRAFT)
  minimumStock Int           @default(0) @map("minimum_stock")
  // Notas internas: p. ej. "PENDIENTE DE CONFIRMAR: talla, costo".
  internalNotes String?      @map("internal_notes")
  isDemo       Boolean       @default(false) @map("is_demo")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  archivedAt   DateTime?     @map("archived_at") @db.Timestamptz

  category Category         @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
  images   ProductImage[]
  supplierProducts SupplierProduct[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  // SKU único: TLS-CMT-001-BLK-M
  sku       String  @unique
  color     String?
  size      String?
  barcode   String? @unique
  // Precio de venta (HNL). Null = PENDIENTE DE CONFIRMAR (no vendible).
  price     Decimal? @db.Decimal(12, 2)
  // Costo promedio ponderado, actualizado al recibir compras.
  cost      Decimal? @db.Decimal(12, 2)
  // Stock mínimo propio; null = usa el del producto.
  minimumStock Int?  @map("minimum_stock")
  active    Boolean  @default(true)
  isDemo    Boolean  @default(false) @map("is_demo")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  product       Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventory     Inventory?
  movements     InventoryMovement[]
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]

  @@unique([productId, color, size])
  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  // Clave en el almacenamiento de objetos (no el archivo en sí).
  storageKey String   @map("storage_key")
  url        String
  alt        String?
  position   Int      @default(0)
  isCover    Boolean  @default(false) @map("is_cover")
  width      Int?
  height     Int?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

// ───────────────────────── Inventario ─────────────────────────

// Un registro por variante (una sola ubicación por ahora; location_id en el futuro).
model Inventory {
  variantId String   @id @map("variant_id")
  onHand    Int      @default(0) @map("on_hand")
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@map("inventory")
}

enum MovementType {
  INICIAL
  COMPRA
  VENTA
  DEVOLUCION
  CORRECCION
  DANO
  PERDIDA
  AJUSTE
  CANCELACION
}

// Libro mayor inmutable del inventario. Nunca se edita ni se borra.
model InventoryMovement {
  id             String       @id @default(cuid())
  variantId      String       @map("variant_id")
  type           MovementType
  quantityBefore Int          @map("quantity_before")
  quantityChange Int          @map("quantity_change")
  quantityAfter  Int          @map("quantity_after")
  // Costo unitario asociado (compras: costo real; ventas: costo de venta).
  unitCost       Decimal?     @map("unit_cost") @db.Decimal(12, 2)
  reason         String?
  // Referencia: "sale" | "purchase" | "manual"
  referenceType  String?      @map("reference_type")
  referenceId    String?      @map("reference_id")
  userId         String?      @map("user_id")
  isDemo         Boolean      @default(false) @map("is_demo")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  user    User?          @relation(fields: [userId], references: [id])

  @@index([variantId, createdAt])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("inventory_movements")
}

// ───────────────────────── Comprar ─────────────────────────

model Supplier {
  id           String   @id @default(cuid())
  name         String
  company      String?
  phone        String?
  whatsapp     String?
  email        String?
  address      String?
  leadTimeDays Int?     @map("lead_time_days")
  notes        String?
  active       Boolean  @default(true)
  isDemo       Boolean  @default(false) @map("is_demo")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  purchases Purchase[]
  products  SupplierProduct[]

  @@map("suppliers")
}

model SupplierProduct {
  supplierId String @map("supplier_id")
  productId  String @map("product_id")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([supplierId, productId])
  @@map("supplier_products")
}

enum PurchaseStatus {
  BORRADOR
  ORDENADA
  ENVIADA
  RECIBIDA
  CANCELADA
}

model Purchase {
  id            String         @id @default(cuid())
  code          String         @unique // TEL-C-00001
  supplierId    String?        @map("supplier_id")
  status        PurchaseStatus @default(BORRADOR)
  orderedAt     DateTime       @default(now()) @map("ordered_at") @db.Timestamptz
  receivedAt    DateTime?      @map("received_at") @db.Timestamptz
  subtotal      Decimal        @db.Decimal(12, 2)
  shippingCost  Decimal        @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  taxes         Decimal        @default(0) @db.Decimal(12, 2)
  otherCosts    Decimal        @default(0) @map("other_costs") @db.Decimal(12, 2)
  total         Decimal        @db.Decimal(12, 2)
  paymentMethod String?        @map("payment_method")
  notes         String?
  createdById   String?        @map("created_by_id")
  isDemo        Boolean        @default(false) @map("is_demo")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  supplier  Supplier?      @relation(fields: [supplierId], references: [id])
  createdBy User?          @relation(fields: [createdById], references: [id])
  items     PurchaseItem[]

  @@index([status])
  @@index([supplierId])
  @@index([orderedAt])
  @@map("purchases")
}

model PurchaseItem {
  id         String  @id @default(cuid())
  purchaseId String  @map("purchase_id")
  variantId  String  @map("variant_id")
  quantity   Int
  unitCost   Decimal @map("unit_cost") @db.Decimal(12, 2)
  // Costo real unitario (mercancía + prorrateo de transporte/impuestos/otros). Se fija al recibir.
  landedUnitCost Decimal? @map("landed_unit_cost") @db.Decimal(12, 2)

  purchase Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([purchaseId, variantId])
  @@map("purchase_items")
}

// ───────────────────────── Vender ─────────────────────────

model Customer {
  id                String   @id @default(cuid())
  name              String
  phone             String?
  whatsapp          String?
  email             String?
  city              String?
  acquisitionSource String?  @map("acquisition_source")
  notes             String?
  isDemo            Boolean  @default(false) @map("is_demo")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sales Sale[]

  @@index([name])
  @@index([phone])
  @@map("customers")
}

enum SaleStatus {
  PENDIENTE
  CONFIRMADA
  ENTREGADA
  CANCELADA
  DEVUELTA
}

enum PaymentStatus {
  PENDIENTE
  PARCIAL
  PAGADA
  REEMBOLSADA
}

enum SalesChannel {
  TIENDA
  INSTAGRAM
  FACEBOOK
  TIKTOK
  WHATSAPP
  REFERIDO
  VENTA_DIRECTA
  MARKETPLACE
  WEB
  OTRO
}

model Sale {
  id             String        @id @default(cuid())
  code           String        @unique // TEL-V-00001
  // Evita ventas duplicadas por doble clic o reintentos.
  idempotencyKey String?       @unique @map("idempotency_key")
  customerId     String?       @map("customer_id")
  sellerId       String?       @map("seller_id")
  createdById    String?       @map("created_by_id")
  channel        SalesChannel
  status         SaleStatus    @default(PENDIENTE)
  paymentStatus  PaymentStatus @default(PENDIENTE) @map("payment_status")
  paymentMethod  String?       @map("payment_method")
  soldAt         DateTime      @default(now()) @map("sold_at") @db.Timestamptz
  subtotal       Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  // Se fijan al confirmar (costo histórico).
  costTotal      Decimal?      @map("cost_total") @db.Decimal(12, 2)
  grossProfit    Decimal?      @map("gross_profit") @db.Decimal(12, 2)
  // Marca de que el inventario ya fue descontado: impide doble descuento.
  stockCommittedAt DateTime?   @map("stock_committed_at") @db.Timestamptz
  confirmedAt    DateTime?     @map("confirmed_at") @db.Timestamptz
  deliveredAt    DateTime?     @map("delivered_at") @db.Timestamptz
  cancelledAt    DateTime?     @map("cancelled_at") @db.Timestamptz
  notes          String?
  isDemo         Boolean       @default(false) @map("is_demo")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  customer  Customer?  @relation(fields: [customerId], references: [id])
  seller    User?      @relation("SaleSeller", fields: [sellerId], references: [id])
  createdBy User?      @relation("SaleCreatedBy", fields: [createdById], references: [id])
  items     SaleItem[]
  payments  Payment[]

  @@index([status])
  @@index([soldAt])
  @@index([customerId])
  @@index([channel])
  @@map("sales")
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String   @map("sale_id")
  variantId String   @map("variant_id")
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  discount  Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal Decimal  @map("line_total") @db.Decimal(12, 2)
  // Costo unitario histórico al momento de confirmar.
  unitCost  Decimal? @map("unit_cost") @db.Decimal(12, 2)

  sale    Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([saleId, variantId])
  @@index([variantId])
  @@map("sale_items")
}

model Payment {
  id        String   @id @default(cuid())
  saleId    String   @map("sale_id")
  amount    Decimal  @db.Decimal(12, 2)
  method    String
  paidAt    DateTime @default(now()) @map("paid_at") @db.Timestamptz
  reference String?
  userId    String?  @map("user_id")
  isDemo    Boolean  @default(false) @map("is_demo")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  sale Sale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([saleId])
  @@map("payments")
}

// ───────────────────────── Controlar / Marketing ─────────────────────────

model SocialMetric {
  id            String   @id @default(cuid())
  platform      String // instagram | facebook | tiktok | ...
  periodStart   DateTime @map("period_start") @db.Date
  periodEnd     DateTime @map("period_end") @db.Date
  followers     Int?
  reach         Int?
  impressions   Int?
  profileVisits Int?     @map("profile_visits")
  interactions  Int?
  clicks        Int?
  messages      Int?
  leads         Int?
  attributedSales Int?   @map("attributed_sales")
  source        String   @default("manual") // manual | api
  isDemo        Boolean  @default(false) @map("is_demo")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([platform, periodStart, periodEnd])
  @@map("social_metrics")
}

model MarketingExpense {
  id        String   @id @default(cuid())
  platform  String
  spentOn   DateTime @map("spent_on") @db.Date
  amount    Decimal  @db.Decimal(12, 2)
  campaign  String?
  notes     String?
  isDemo    Boolean  @default(false) @map("is_demo")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([spentOn])
  @@map("marketing_expenses")
}

// ───────────────────────── Sistema ─────────────────────────

model Notification {
  id         String    @id @default(cuid())
  type       String // STOCK_LOW | OUT_OF_STOCK | MISSING_COST | ...
  title      String
  body       String?
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")
  readAt     DateTime? @map("read_at") @db.Timestamptz
  isDemo     Boolean   @default(false) @map("is_demo")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([readAt, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String // product.update, sale.confirm, inventory.adjust...
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum EventStatus {
  PENDING
  PROCESSED
  FAILED
}

// Outbox de eventos de dominio (SALE_CONFIRMED, STOCK_LOW...). Se escribe dentro
// de la misma transacción que el cambio; un despachador lo entrega a webhooks/automatizaciones.
model DomainEvent {
  id          String      @id @default(cuid())
  type        String
  payload     Json
  status      EventStatus @default(PENDING)
  attempts    Int         @default(0)
  lastError   String?     @map("last_error")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  processedAt DateTime?   @map("processed_at") @db.Timestamptz

  @@index([status, createdAt])
  @@map("domain_events")
}

// Contadores atómicos para códigos legibles (TEL-V-00001, TLS-CMT-001).
model Sequence {
  name  String @id
  value Int    @default(0)

  @@map("sequences")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("settings")
}
