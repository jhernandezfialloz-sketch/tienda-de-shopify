# Base de datos PostgreSQL principal
DATABASE_URL="postgresql://telos:telos@localhost:5432/telos_dev"
# Conexión directa para migraciones (en Neon: la URL "unpooled"). En local, la misma.
DATABASE_URL_UNPOOLED="postgresql://telos:telos@localhost:5432/telos_dev"
# Base de datos aislada para tests de integración (se vacía en cada corrida)
DATABASE_URL_TEST="postgresql://telos:telos@localhost:5432/telos_test"

# URL pública del sitio (enlaces de recuperación de contraseña, Open Graph)
APP_URL="http://localhost:3000"

# Zona horaria y moneda de Telos (también editables en /admin/configuracion más adelante)
TELOS_TIMEZONE="America/Tegucigalpa"

# Almacenamiento de imágenes. Si existe BLOB_READ_WRITE_TOKEN (Vercel Blob) se usa "blob";
# si no, "local". Se puede forzar con STORAGE_DRIVER="blob" | "local".
STORAGE_DRIVER=""
BLOB_READ_WRITE_TOKEN=""
# Carpeta de fotos del driver local (por defecto ./storage/uploads)
UPLOADS_DIR=""

# Clave para crear el primer usuario dueño en /admin/primer-uso (inventa una larga y guárdala).
SETUP_TOKEN=""
